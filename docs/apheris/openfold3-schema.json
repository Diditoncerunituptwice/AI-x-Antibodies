              "required": [
                "path"
              ],
              "title": "InputQueryNonPolymerPathChain",
              "type": "object"
            },
            "InputQueryNonPolymerSmilesChain": {
              "additionalProperties": false,
              "description": "Input defining a single small molecule defined as a SMILES.",
              "properties": {
                "chain_id": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional chain ID, unique across all chains in the query. Auto-assigned (A, B, ...) if omitted.",
                  "title": "Chain ID"
                },
                "residue_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
