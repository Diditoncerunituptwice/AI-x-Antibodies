              ],
              "title": "InputQueryChains",
              "type": "object"
            },
            "InputQueryInterChainBond": {
              "additionalProperties": false,
              "description": "Input defining a single bond between two atoms in different chains.\n\nExtends the intra-chain bond format by requiring each endpoint to also identify a\nchain, either by chain ID or chain index.",
              "properties": {
                "atom1_index": {
