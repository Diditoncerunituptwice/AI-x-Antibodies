                "pocket_constraint": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/PocketConstraint"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Binding pocket to guide a binder chain towards. Not supported by all models. For OpenFold3, only supported by the\npreview2 and OpenBind weights.",
                  "title": "Pocket Constraint"
                },
                "query_id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional identifier for the query. Defaults to `query_{n}` (1-indexed) if omitted. May only contain letters, digits,\n`.`, `_` and `-`, and must not start with `.`.",
                  "title": "Query ID"
                }
              },
              "required": [
