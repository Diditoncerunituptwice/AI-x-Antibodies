            "InputQueryNonPolymerComponentChain": {
              "additionalProperties": false,
              "description": "Input defining a single small molecule by CCD or custom component ID.",
              "properties": {
                "chain_id": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional chain ID, unique across all chains in the query. Auto-assigned (A, B, ...) if omitted.",
                  "title": "Chain ID"
                },
                "component_id": {
                  "description": "CCD component ID for the small molecule (e.g. 'HEM', 'ATP').",
                  "examples": [
                    "HEM"
                  ],
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "Component ID",
                  "type": "string"
                },
                "residue_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional label for this residue within the chain. Defaults to '1' if omitted.",
                  "title": "Residue ID"
                },
                "residue_name": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Ignored: the residue name of a component is always its `component_id`.",
                  "title": "Residue Name"
                }
              },
              "required": [
                "component_id"
              ],
              "title": "InputQueryNonPolymerComponentChain",
              "type": "object"
            },
            "InputQueryNonPolymerPathChain": {
              "additionalProperties": false,
              "description": "Input defining a single small molecule loaded from a structure file.",
              "properties": {
                "chain_id": {
                  "anyOf": [
