                "bonds": {
                  "description": "Additional covalent bonds between chains.",
                  "items": {
                    "$ref": "#/$defs/InputQueryInterChainBond"
                  },
                  "title": "Additional Covalent Bonds",
                  "type": "array"
                },
                "chains": {
                  "description": "Chains included in the query.",
