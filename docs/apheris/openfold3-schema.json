                    "oneOf": [
                      {
                        "$ref": "#/$defs/InputQueryPolymerSequenceChain"
                      },
                      {
                        "$ref": "#/$defs/InputQueryBranchedPolymerComponentChain"
                      },
                      {
                        "$ref": "#/$defs/InputQueryNonPolymerSmilesChain"
                      },
                      {
                        "$ref": "#/$defs/InputQueryNonPolymerPathChain"
