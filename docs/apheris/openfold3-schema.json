                  "default": null,
                  "description": "Optional label for this residue within the chain. Defaults to '1' if omitted.",
                  "title": "Residue ID"
                },
                "residue_name": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional residue name. Auto-generated (e.g. '00', '01') if omitted.",
                  "title": "Residue Name"
                },
                "smiles": {
                  "description": "SMILES string defining the small molecule.",
                  "examples": [
                    "CC(=O)Oc1ccccc1C(=O)O"
                  ],
                  "format": "smiles",
                  "minLength": 1,
                  "pattern": "\\S",
                  "title": "SMILES",
                  "type": "string"
                }
              },
              "required": [
                "smiles"
              ],
              "title": "InputQueryNonPolymerSmilesChain",
              "type": "object"
            },
            "InputQueryPath": {
              "additionalProperties": false,
              "description": "Input defining a query by reference to an existing biomolecule file.",
              "properties": {
                "path": {
                  "description": "Path to a structure file (CIF/PDB) defining the whole query. Chains, entities, and bonds are all inferred from the\nfile; any water molecules and disulfide bonds in it are dropped.",
                  "format": "file-path",
                  "title": "Query Structure File Path",
                  "type": "string",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                "pocket_constraint": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/PocketConstraint"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Binding pocket to guide a binder chain towards. Not supported by all models. For OpenFold3, only supported by the\npreview2 and OpenBind weights.",
                  "title": "Pocket Constraint"
                },
                "query_id": {
                  "anyOf": [
                    {
                      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional identifier for the query. Defaults to `query_{n}` (1-indexed) if omitted. May only contain letters, digits,\n`.`, `_` and `-`, and must not start with `.`.",
                  "title": "Query ID"
                }
              },
              "required": [
                "path"
              ],
              "title": "InputQueryPath",
              "type": "object"
            },
            "InputQueryPolymerSequenceChain": {
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "polymer_type": {
                        "const": "protein"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "sequence": {
                        "pattern": "^\\s*(?:[ACDEFGHIKLMNOPQRSTUVWXY]\\s*|\\(\\s*(?:[A-Za-z0-9_,.;:\"\u0026\u003c\u003e/\\\\{}'`~!@#$%*|+-]\\s*)+\\)\\s*)*$",
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "polymer_type": {
                        "const": "dna"
                      }
                    },
                    "required": [
                      "polymer_type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "sequence": {
                        "pattern": "^\\s*(?:[ACGINT]\\s*|\\(\\s*(?:[A-Za-z0-9_,.;:\"\u0026\u003c\u003e/\\\\{}'`~!@#$%*|+-]\\s*)+\\)\\s*)*$",
                        "type": "string"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "polymer_type": {
                        "const": "rna"
                      }
                    },
                    "required": [
                      "polymer_type"
                    ]
                  },
                  "then": {
                    "properties": {
                      "sequence": {
                        "pattern": "^\\s*(?:[ACGINU]\\s*|\\(\\s*(?:[A-Za-z0-9_,.;:\"\u0026\u003c\u003e/\\\\{}'`~!@#$%*|+-]\\s*)+\\)\\s*)*$",
                        "type": "string"
                      }
                    }
                  }
                }
              ],
              "description": "Input defining a single polymer chain.",
              "properties": {
                "bonds": {
                  "description": "Additional covalent bonds between atoms within this chain.",
                  "items": {
                    "$ref": "#/$defs/InputQueryIntraChainBond"
                  },
                  "title": "Additional Covalent Bonds",
                  "type": "array"
                },
                "chain_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional chain ID, unique across all chains in the query. Auto-assigned (A, B, ...) if omitted. Used to reference\nthis chain from bonds.",
                  "title": "Chain ID"
                },
                "cyclic": {
                  "default": false,
                  "description": "Whether the chain is cyclic, adding a bond between its first and last residues.",
                  "title": "Cyclic Polymer Flag",
                  "type": "boolean"
                },
                "msa_path": {
                  "anyOf": [
                    {
                      "format": "file-path",
                      "pattern": "(?i)(\\.a3m)$",
                      "type": "string",
                      "x-foundry-extensions": [
                        ".a3m"
                      ],
                      "x-foundry-path-resolution": "relative-or-absolute"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional path to this chain's own MSA file, in A3M format (`.a3m`). If omitted, an MSA is instead looked up by\nsequence from the MSA directory, if one was provided. Set to null to predict this chain without an MSA.",
                  "title": "MSA File Path"
                },
                "polymer_type": {
                  "$ref": "#/$defs/PolymerType",
                  "default": "protein",
                  "description": "Type of the polymer, which determines the valid alphabet for `sequence`.",
                  "title": "Polymer Type"
                },
                "residue_ids": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional per-residue labels, one per residue in `sequence`. Auto-numbered '1', '2', ... if omitted. Used to\nreference specific residues from bonds.",
                  "examples": [
                    "1-3,5-6,6A"
                  ],
                  "title": "Residue IDs"
                },
                "sequence": {
                  "description": "Sequence of the polymer, with nonstandard residues written in parentheses. For example, \"AC(SEP)T\", when interpreted\nas a protein, represents the sequence of residues \"ALA-CYS-SEP-THR\", where \"SEP\" is a nonstandard residue.",
                  "examples": [
                    "AC(SEP)T",
                    "GCGCG(5CM)G(5CM)"
                  ],
                  "minLength": 1,
                  "title": "Polymer Sequence",
                  "type": "string"
                }
              },
              "required": [
                "sequence"
              ],
              "title": "InputQueryPolymerSequenceChain",
              "type": "object"
            },
            "PocketConstraint": {
              "additionalProperties": false,
              "description": "Constraint guiding a binder chain towards a binding pocket.",
              "properties": {
                "binder_chain_index": {
                  "description": "The chain to place in the pocket, by 0-based index in the query's chain list.",
                  "minimum": 0,
                  "title": "Binder Chain Index",
                  "type": "integer"
                },
                "binding_residues": {
                  "description": "Residues lining the binding pocket.",
                  "items": {
                    "$ref": "#/$defs/PocketConstraintBindingResidue"
                  },
                  "minItems": 1,
                  "title": "Binding Residues",
                  "type": "array"
                },
                "max_distance": {
                  "anyOf": [
                    {
                      "exclusiveMinimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Maximum distance (Å) between the binder and binding residues. Defaults to the model's default.",
                  "title": "Maximum Distance"
                }
              },
              "required": [
                "binder_chain_index",
                "binding_residues"
              ],
              "title": "PocketConstraint",
              "type": "object"
            },
            "PocketConstraintBindingResidue": {
              "additionalProperties": false,
              "description": "A residue in a binding pocket.",
              "properties": {
                "chain_index": {
                  "description": "The residue's chain, by 0-based index in the query's chain list.",
                  "minimum": 0,
                  "title": "Chain Index",
                  "type": "integer"
                },
                "residue_index": {
                  "description": "The residue, by 0-based index within its chain.",
                  "minimum": 0,
                  "title": "Residue Index",
                  "type": "integer"
                }
              },
              "required": [
                "chain_index",
                "residue_index"
              ],
              "title": "PocketConstraintBindingResidue",
              "type": "object"
            },
            "PolymerType": {
              "description": "The type of a polymer chain: `protein`, `rna` or `dna`.",
              "enum": [
                "protein",
                "rna",
                "dna"
              ],
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Input for the Apheris OpenFold3 prediction wrapper.",
          "properties": {
            "queries": {
              "description": "One or more structures to predict, each made up of one or more chains.",
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/InputQueryChains"
                  },
                  {
                    "$ref": "#/$defs/InputQueryPath"
                  }
                ]
              },
              "minItems": 1,
              "title": "Queries",
              "type": "array"
            }
          },
          "required": [
            "queries"
          ],
          "title": "PredictOpenFold3Input",
          "type": "object"
        },
        "inputs": [
          {
            "flag": "--input",
            "repeatable": false,
            "required": true,
            "type": "file or directory"
          }
        ],
        "invocation": "apheris-openfold3 predict --input ./in --output ./run",
        "name": "predict",
        "output": {
          "flag": "--output",
          "required": true,
          "type": "directory"
        },
        "output_schema": {
          "$defs": {
            "FailedQuery": {
              "additionalProperties": false,
              "description": "A query left out of a run's predictions, and why.",
              "properties": {
                "error_type": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "The type of error the query failed with, or absent if the model only reported that it failed.",
                  "title": "Error Type"
                },
                "message": {
                  "description": "What went wrong.",
                  "title": "Message",
                  "type": "string"
                },
                "query_id": {
                  "description": "Identifier of the query that failed.",
                  "title": "Query ID",
                  "type": "string"
                },
                "query_index": {
                  "description": "The 0-based position of the query in the input query list.",
                  "title": "Query Index",
                  "type": "integer"
                },
                "seed": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "The seed the query failed for, or absent if it failed before any seed was used.",
                  "title": "Seed"
                },
                "stage": {
                  "$ref": "#/$defs/QueryFailureStage",
                  "description": "The step the query failed at: `resolution`, `featurization` or `prediction`.",
                  "title": "Stage"
                }
              },
              "required": [
                "query_id",
                "query_index",
                "stage",
                "message"
              ],
              "title": "FailedQuery",
              "type": "object"
            },
            "OpenFold3DetailedPredictionScores": {
              "additionalProperties": false,
              "description": "Per-atom and token-pair confidence scores returned for a prediction by OpenFold3.",
              "properties": {
                "atom_predicted_local_distance_difference_test": {
                  "description": "Per-atom predicted local distance difference test (pLDDT) score, in [0, 100].\n\nHigher values indicate a higher confidence in the local atom position.",
                  "title": "Per-Atom Predicted Local Distance Difference Test (pLDDT)"
                },
                "atom_tokens": {
                  "description": "0-based index of the token for each atom.\n\nA token is an internal grouping within the model - each polymer residue belongs to\na single token, and each non-polymer/ligand heavy atom belongs to a single token.",
                  "title": "Atom Tokens"
                },
                "token_token_predicted_aligned_error": {
                  "description": "Predicted aligned error (PAE) for all pairs of tokens, in Angstroms.\n\nThe (i, j) entry is the expected position error of token j if the structure were aligned on\ntoken i's local frame. Lower is more confident.",
                  "title": "Token-Token Predicted Aligned Error (PAE)"
                },
                "token_token_predicted_distance_error": {
                  "description": "Predicted distance error (PDE) for all pairs of tokens, in Angstroms.\n\nThe (i, j) entry is the expected error in the distance between tokens i and j; symmetric.\nLower is more confident.",
                  "title": "Token-Token Predicted Distance Error (PDE)"
                }
              },
              "required": [
                "atom_predicted_local_distance_difference_test",
                "token_token_predicted_aligned_error",
                "token_token_predicted_distance_error",
                "atom_tokens"
              ],
              "title": "OpenFold3DetailedPredictionScores",
              "type": "object"
            },
            "OpenFold3PredictionScores": {
              "additionalProperties": false,
              "description": "Summary confidence scores (and a few structural counts) returned for a prediction by OpenFold3.\n\nThe per-atom and token-pair scores are in `OpenFold3DetailedPredictionScores`.",
              "properties": {
                "average_predicted_local_distance_difference_test": {
                  "description": "Mean of the detailed scores' per-atom pLDDT, in [0, 100].\n\nA single global confidence summary for the whole prediction.",
                  "title": "Average Predicted Local Distance Difference Test (pLDDT)",
                  "type": "number"
                },
                "chain_chain_interface_predicted_tm_score": {
                  "description": "Pairwise interface predicted TM-score between every pair of chains.\n\nThe (i, j) entry is the ipTM computed over just chains i and j (the predicted structure's\nchain i/j, A, B, C, ...); symmetric. The diagonal is not meaningful (use\n`chain_predicted_tm_score` for single-chain confidence). `null` if OpenFold3 didn't compute\nthis pair (no inter-chain contact between chains i and j).",
                  "items": {
                    "items": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "type": "array"
                  },
                  "title": "Chain-Chain Interface Predicted TM-Score (ipTM)",
                  "type": "array"
                },
                "chain_predicted_tm_score": {
                  "description": "Per-chain predicted TM-score, between 0 and 1.\n\nThe same pTM computation as `predicted_tm_score`, but restricted to a single chain's tokens.\nIndex i is the predicted structure's chain i (A, B, C, ...).",
                  "items": {
                    "type": "number"
                  },
                  "title": "Per-Chain Predicted TM-Score (pTM)",
                  "type": "array"
                },
                "clash_flag": {
                  "description": "Does any pair of polymer chains have a steric clash.",
                  "title": "Clash Flag",
                  "type": "boolean"
                },
                "disorder": {
                  "description": "Disorder score: the average relative accessible surface area (RASA), computed from the\npredicted structure's coordinates, over residues the model left unresolved.\n\nNot a direct model output - unresolved residues that are also solvent-exposed are a proxy\nfor disordered regions.\n\nOnly computed when the structure contains protein chains; 0.0 otherwise.\n\nHigher indicates more disorder.",
                  "title": "Disorder",
                  "type": "number"
                },
                "global_predicted_distance_error": {
                  "description": "Global predicted distance error (gPDE), in Angstroms.\n\nA single scalar summary of `token_token_predicted_distance_error`, weighted by predicted\ninter-token contact probability (AF3 SI 5.7). Lower is more confident.",
                  "title": "Global Predicted Distance Error (gPDE)",
                  "type": "number"
                },
                "interface_predicted_tm_score": {
                  "description": "Interface predicted TM-score (ipTM), between 0 and 1.\n\nSimilar to `predicted_tm_score`, but restricted to inter-chain contacts.\nHigher is more confident.",
                  "title": "Interface Predicted TM-Score (ipTM)",
                  "type": "number"
                },
                "model_ranking_score": {
                  "description": "OpenFold3's composite score used to rank diffusion samples (AF3 SI 5.9.3 item 1).\n\nEqual to `0.8 * iptm + 0.2 * ptm + 0.5 * disorder - 100 * clash_flag`.\n\nHigher is better; the large clash penalty means any clash dominates the score.",
                  "title": "Model Ranking Score",
                  "type": "number"
                },
                "num_atoms": {
                  "description": "Total number of atoms in the predicted structure.",
                  "title": "Number of Atoms",
                  "type": "integer"
                },
                "num_bonds": {
                  "description": "Total number of bonds in the predicted structure.",
                  "title": "Number of Bonds",
                  "type": "integer"
                },
                "num_chains": {
                  "description": "Total number of chains in the predicted structure.",
                  "title": "Number of Chains",
                  "type": "integer"
                },
                "num_residues": {
                  "description": "Total number of residues in the predicted structure.",
                  "title": "Number of Residues",
                  "type": "integer"
                },
                "num_tokens": {
                  "description": "Total number of tokens in the predicted structure.",
                  "title": "Number of Tokens",
                  "type": "integer"
                },
                "predicted_tm_score": {
                  "description": "Predicted TM-score (pTM) for the full complex, between 0 and 1.\n\nEstimate of the TM-score the prediction would achieve against the (unknown) true structure.\nHigher is more confident.",
                  "title": "Predicted TM-Score (pTM)",
                  "type": "number"
                }
              },
              "required": [
                "average_predicted_local_distance_difference_test",
                "global_predicted_distance_error",
                "predicted_tm_score",
                "interface_predicted_tm_score",
                "chain_predicted_tm_score",
                "chain_chain_interface_predicted_tm_score",
                "disorder",
                "clash_flag",
                "model_ranking_score",
                "num_atoms",
                "num_bonds",
                "num_residues",
                "num_chains",
                "num_tokens"
              ],
              "title": "OpenFold3PredictionScores",
              "type": "object"
            },
            "Prediction": {
              "description": "A single predicted structure written by the prediction pipeline.",
              "properties": {
                "detailed_scores_path": {
                  "description": "Path to this prediction's gzipped `OpenFold3DetailedPredictionScores` CBOR file, with its per-atom and token-pair scores, relative to the task's output folder. Only written with `write_detailed_scores`.",
                  "format": "file-path",
                  "pattern": "(?i)(\\.cbor)(\\.gz)?$",
                  "title": "Detailed Scores File Path",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz"
                  ],
                  "x-foundry-extensions": [
                    ".cbor"
                  ],
                  "x-foundry-mimetype": "application/cbor",
                  "x-foundry-path-resolution": "relative",
                  "x-foundry-path-traversal": false,
                  "x-foundry-schema": {
                    "$ref": "#/$defs/OpenFold3DetailedPredictionScores"
                  }
                },
                "path": {
                  "description": "Path to the predicted structure's CIF file, relative to the task's output folder.",
                  "format": "file-path",
                  "pattern": "(?i)(\\.cif)$",
                  "title": "Structure File Path",
                  "type": "string",
                  "x-foundry-extensions": [
                    ".cif"
                  ],
                  "x-foundry-mimetype": "chemical/x-cif",
                  "x-foundry-path-resolution": "relative",
                  "x-foundry-path-traversal": false
                },
                "query_id": {
                  "description": "Identifier of the query that produced this prediction.",
                  "title": "Query ID",
                  "type": "string"
                },
                "query_index": {
                  "description": "The 0-based position of this prediction's query in the input query list.",
                  "title": "Query Index",
                  "type": "integer"
                },
                "sample": {
                  "description": "The (1-indexed) diffusion sample number this prediction corresponds to.",
                  "title": "Sample Number",
                  "type": "integer"
                },
                "scores_path": {
                  "description": "Path to this prediction's `OpenFold3PredictionScores` JSON file, relative to the task's output folder.",
                  "format": "file-path",
                  "pattern": "(?i)(\\.json)$",
                  "title": "Scores File Path",
                  "type": "string",
                  "x-foundry-extensions": [
                    ".json"
                  ],
                  "x-foundry-mimetype": "application/json",
                  "x-foundry-path-resolution": "relative",
                  "x-foundry-path-traversal": false,
                  "x-foundry-schema": {
                    "$ref": "#/$defs/OpenFold3PredictionScores"
                  }
                },
                "seed": {
                  "description": "The seed used to generate this prediction.",
                  "title": "Seed",
                  "type": "integer"
                }
              },
              "required": [
                "query_id",
                "query_index",
                "path",
                "sample",
                "seed",
                "scores_path"
              ],
              "title": "Prediction",
              "type": "object"
            },
            "QueryFailureStage": {
              "enum": [
                "resolution",
                "featurization",
                "prediction"
              ],
              "type": "string"
            }
          },
          "description": "Result of the predict task.",
          "properties": {
            "failed_queries": {
              "description": "Queries left out of the predictions because they failed, and why. Only set when skipping them.",
              "items": {
                "$ref": "#/$defs/FailedQuery"
              },
              "title": "Failed Queries",
              "type": "array"
            },
            "predictions": {
              "description": "Every structure predicted by this run.",
              "items": {
                "$ref": "#/$defs/Prediction"
              },
              "title": "Predictions",
              "type": "array"
            }
          },
          "required": [
            "predictions"
          ],
          "title": "PredictOpenFold3Result",
          "type": "object"
        },
        "parameters": {
          "$defs": {
            "MissingMsaBehaviour": {
              "description": "What to do with a chain that has no MSA: `fail` rejects it, `ignore` predicts it without one.",
              "enum": [
                "fail",
                "ignore"
              ],
              "type": "string"
            },
            "QueryFailureBehaviour": {
              "enum": [
                "fail",
                "skip"
              ],
              "type": "string"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "description": "Config for the Apheris OpenFold3 prediction wrapper.",
          "properties": {
            "missing_msas": {
              "$ref": "#/$defs/MissingMsaBehaviour",
              "default": "fail",
              "description": "What to do if a chain that needs an MSA has none, either its own msa_path or a match in msa_dir: 'fail' rejects the\nquery, 'ignore' predicts it without one. Chains with msa_path explicitly set to null are always predicted without an\nMSA.",
              "title": "Missing MSA Behaviour"
            },
            "missing_rna_msas": {
              "$ref": "#/$defs/MissingMsaBehaviour",
              "description": "What to do if an RNA chain has no MSA, overriding missing_msas for RNA chains: 'fail' rejects the query, 'ignore'\npredicts it without one. Unset, RNA chains follow missing_msas.",
              "title": "Missing RNA MSA Behaviour"
            },
            "msa_dir": {
              "description": "Directory of precomputed MSA files. Chains without their own MSA are matched to one here by sequence, not by\nfilename.",
              "format": "directory-path",
              "title": "MSA Directory",
              "type": "string",
              "x-foundry-path-resolution": "relative-or-absolute"
            },
            "num_diffusion_samples": {
              "default": 5,
              "description": "Number of structures to sample from the diffusion model.",
              "minimum": 1,
              "title": "Diffusion Sample Count",
              "type": "integer"
            },
            "query_failures": {
              "$ref": "#/$defs/QueryFailureBehaviour",
              "default": "fail",
              "description": "What to do if a query can't be predicted, because it's invalid or fails to featurize or predict: 'fail' stops the\nrun, reporting every invalid query before prediction starts, or else at the first query that fails; 'skip' predicts\nthe other queries and lists each failed one, with the reason, in the result.",
              "title": "Query Failure Behaviour"
            },
            "seeds": {
              "default": [
                42
              ],
              "description": "Random seeds to use for prediction.",
              "items": {
                "minimum": 0,
                "type": "integer"
              },
              "minItems": 1,
              "title": "Seeds",
              "type": "array"
            },
            "template_paths": {
              "description": "Optional template structure file(s) (CIF/PDB), applied to every query. Each chain is matched to its best-aligning\nchain (normalized global-alignment score \u003e0.5) in each file - not by chain ID or order - so multiple files can each\ncontribute one template per chain. Partial matches are allowed: some chains may remain untemplated as long as at\nleast one eligible chain in the query matches. Validation only fails if none of the query's chains match any file.\nOnly chain types the model uses templates for are matched.",
              "examples": [
                [
                  "templates/6vxx.cif"
                ]
              ],
              "items": {
                "format": "file-path",
                "type": "string",
                "x-foundry-path-resolution": "relative-or-absolute"
              },
              "title": "Template Structure Paths",
              "type": "array"
            },
            "weights": {
              "description": "A valid model checkpoint. Its model variant is inferred from the shape of its weights, not from the filename.",
              "format": "file-path",
              "pattern": "(?i)(\\.pt|\\.ckpt)$",
              "title": "Model Weights Path",
              "type": "string",
              "x-foundry-envvar": "APHERIS_DEFAULT_WEIGHTS",
              "x-foundry-extensions": [
                ".pt",
                ".ckpt"
              ],
              "x-foundry-path-resolution": "relative-or-absolute"
            },
            "write_detailed_scores": {
              "default": false,
              "description": "Also write each prediction's per-atom and token-pair scores (pLDDT, PAE, PDE and atom tokens) to a gzipped CBOR file\nalongside its scores JSON. These grow with the square of the number of tokens, so are left out by default.",
              "title": "Write Detailed Scores",
              "type": "boolean"
            }
          },
          "title": "PredictOpenFold3Config",
          "type": "object",
          "x-foundry-flags": {
            "missing_msas": "--missing-msas",
            "missing_rna_msas": "--missing-rna-msas",
            "msa_dir": "--msa-dir",
            "num_diffusion_samples": "--num-diffusion-samples",
            "query_failures": "--query-failures",
            "seeds": "--seeds",
            "template_paths": "--template-paths",
            "weights": "--weights",
            "write_detailed_scores": "--write-detailed-scores"
          }
        },
        "schema_version": "foundry.cli.v1"
      },
      {
        "description": "",
        "exit_codes": [
          {
            "category": "success",
            "code": 0,
            "meaning": "success"
          },
          {
            "category": "internal",
            "code": 1,
            "meaning": "unexpected or uncaught error"
          },
          {
            "category": "usage",
            "code": 2,
            "meaning": "bad invocation or invalid config"
          },
          {
            "category": "input-data",
            "code": 3,
            "meaning": "inputs present but invalid"
          },
          {
            "category": "precondition",
            "code": 4,
            "meaning": "required resource absent"
          },
          {
            "category": "output",
            "code": 5,
            "meaning": "result produced but could not be persisted"
          },
          {
            "category": "cancelled",
            "code": 130,
            "meaning": "cancelled by SIGINT or SIGTERM"
          }
        ],
        "input_schema": {
          "$defs": {
            "InputCCDCustomComponent": {
              "additionalProperties": false,
              "description": "Custom component defined by a CCD ID.",
              "properties": {
                "ccd": {
                  "title": "Ccd",
                  "type": "string"
                },
                "id": {
                  "title": "Id",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "ccd"
              ],
              "title": "InputCCDCustomComponent",
              "type": "object"
            },
            "InputFullSequence": {
              "additionalProperties": false,
              "description": "Provided full sequence for a specific chain.",
              "properties": {
                "chain_id": {
                  "title": "Chain Id",
                  "type": "string"
                },
                "sequence": {
                  "title": "Sequence",
                  "type": "string"
                }
              },
              "required": [
                "chain_id",
                "sequence"
              ],
              "title": "InputFullSequence",
              "type": "object"
            },
            "InputPathCustomComponent": {
              "additionalProperties": false,
              "description": "Custom component defined by a file.",
              "properties": {
                "id": {
                  "title": "Id",
                  "type": "string"
                },
                "path": {
                  "$ref": "#/$defs/MoleculePath"
                }
              },
              "required": [
                "id",
                "path"
              ],
              "title": "InputPathCustomComponent",
