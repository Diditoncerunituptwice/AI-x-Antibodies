                "smiles"
              ],
              "title": "InputSMILESCustomComponent",
              "type": "object"
            },
            "InputStructureDefinition": {
              "additionalProperties": false,
              "description": "`apheris_data` input structure plus an optional `id` used to key output paths, and its split.",
              "properties": {
                "custom_components": {
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/InputSMILESCustomComponent"
                      },
                      {
                        "$ref": "#/$defs/InputCCDCustomComponent"
                      },
                      {
                        "$ref": "#/$defs/InputPathCustomComponent"
                      }
                    ]
                  },
                  "title": "Custom Components",
                  "type": "array"
                },
                "full_sequences": {
                  "items": {
                    "$ref": "#/$defs/InputFullSequence"
                  },
                  "title": "Full Sequences",
                  "type": "array"
                },
                "id": {
                  "description": "Optional unique ID for this structure. Defaults to the lowercased filename stem if omitted.",
                  "title": "Structure ID",
                  "type": "string"
                },
                "include": {
                  "$ref": "#/$defs/InputStructureInclude"
                },
                "path": {
                  "$ref": "#/$defs/StructurePath"
                },
                "split": {
                  "$ref": "#/$defs/TrainingSplit",
                  "description": "Which dataset split this structure belongs to. Each split is written to its own per-split training files; 'val' is\nused for validation during finetuning.",
                  "title": "Dataset Split"
                }
              },
              "required": [
                "path",
                "split"
              ],
              "title": "InputStructureDefinition",
              "type": "object"
            },
            "InputStructureInclude": {
              "additionalProperties": false,
              "description": "Filters restricting which parts of an input structure are kept during preprocessing.",
              "properties": {
                "chain_ids": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Chain Ids",
                  "type": "array"
                }
              },
              "title": "InputStructureInclude",
              "type": "object"
            },
            "MoleculePath": {
              "anyOf": [
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.cif|\\.mmcif)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".cif",
                    ".mmcif"
                  ],
                  "x-foundry-mimetype": "chemical/x-mmcif",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.sdf)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".sdf"
                  ],
                  "x-foundry-mimetype": "chemical/x-mdl-sdfile",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.mol2)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".mol2"
                  ],
                  "x-foundry-mimetype": "chemical/x-mol2",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.pdb)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".pdb"
                  ],
                  "x-foundry-mimetype": "chemical/x-pdb",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.smi|\\.smiles)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".smi",
                    ".smiles"
                  ],
                  "x-foundry-mimetype": "chemical/x-daylight-smiles",
                  "x-foundry-path-resolution": "relative-or-absolute"
                }
              ]
            },
            "StructurePath": {
              "anyOf": [
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.cif|\\.mmcif)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".cif",
                    ".mmcif"
                  ],
                  "x-foundry-mimetype": "chemical/x-mmcif",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.pdb)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".pdb"
                  ],
                  "x-foundry-mimetype": "chemical/x-pdb",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                {
                  "format": "file-path",
                  "pattern": "(?i)(\\.cbor)(\\.gz|\\.bz2)?$",
                  "type": "string",
                  "x-foundry-compression": [
                    ".gz",
                    ".bz2"
                  ],
                  "x-foundry-extensions": [
                    ".cbor"
                  ],
                  "x-foundry-mimetype": "application/cbor",
                  "x-foundry-path-resolution": "relative-or-absolute"
                }
              ],
              "description": "Path to a structure file in any supported format."
            },
            "TrainingSplit": {
              "description": "The dataset split a structure belongs to.",
              "enum": [
                "train",
                "val",
                "test"
              ],
              "type": "string"
            }
          },
          "description": "Defines the input required to run the OpenFold3 training dataset generation pipeline.",
          "properties": {
            "msa_directory": {
              "anyOf": [
                {
                  "format": "directory-path",
                  "type": "string",
                  "x-foundry-path-resolution": "relative-or-absolute"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Directory of precomputed MSA files. Protein/RNA chains without their own MSA are matched to one here by sequence,\nnot by filename.",
              "title": "MSA Directory"
            },
            "structures": {
              "description": "Input structures to include in the generated dataset.",
              "items": {
                "$ref": "#/$defs/InputStructureDefinition"
              },
              "title": "Structures",
              "type": "array"
            }
          },
          "required": [
            "structures"
          ],
          "title": "GenerateOpenFold3DatasetInput",
          "type": "object"
        },
        "inputs": [
          {
            "flag": "--input",
            "repeatable": true,
            "required": true,
            "type": "file or directory"
          }
        ],
        "invocation": "apheris-openfold3 generate-dataset --input ./in --output ./run",
        "name": "generate-dataset",
        "output": {
          "flag": "--output",
          "required": true,
          "type": "directory"
        },
        "output_schema": {
          "description": "Result of the generate-dataset task.",
          "properties": {
            "dataset_path": {
              "description": "Directory containing the generated dataset, to pass as the input to finetune.",
              "format": "directory-path",
              "title": "Dataset Path",
              "type": "string",
              "x-foundry-path-resolution": "relative",
              "x-foundry-path-traversal": false
            },
            "num_chains": {
              "description": "Total number of chains across all structures.",
              "title": "Number of Chains",
              "type": "integer"
            },
            "num_missing_msas": {
              "description": "Number of protein/RNA sequences with no matching MSA (see missing_msas).",
              "title": "Number of Missing MSAs",
              "type": "integer"
            },
            "num_preprocessing_failures": {
              "description": "Number of structures that failed preprocessing (see preprocessing_failures).",
              "title": "Number of Preprocessing Failures",
              "type": "integer"
            },
            "num_reference_molecules": {
              "description": "Number of distinct non-polymer reference molecules found across all structures.",
              "title": "Number of Reference Molecules",
              "type": "integer"
            },
            "num_structure_processing_failures": {
              "description": "Number of structures OpenFold3 failed to process (see structure_processing_failures).",
              "title": "Number of Structure Processing Failures",
              "type": "integer"
            },
            "num_structures": {
              "description": "Number of input structures included in the dataset.",
              "title": "Number of Structures",
              "type": "integer"
            },
            "num_validation_failures": {
              "description": "Number of structures that failed geometric validation (see validation_failures).",
              "title": "Number of Validation Failures",
              "type": "integer"
            }
          },
          "required": [
            "dataset_path",
            "num_structures",
            "num_preprocessing_failures",
            "num_validation_failures",
            "num_structure_processing_failures",
            "num_chains",
            "num_reference_molecules",
            "num_missing_msas"
          ],
          "title": "GenerateOpenFold3DatasetResult",
          "type": "object"
        },
        "parameters": {
          "$defs": {
            "MissingMsaBehaviour": {
              "description": "What to do with a chain that has no MSA: `fail` rejects it, `ignore` predicts it without one.",
              "enum": [
                "fail",
                "ignore"
              ],
              "type": "string"
            },
            "MsaFailureBehaviour": {
              "description": "What to do with an MSA that can't be read: `fail` aborts, `remove` leaves it out.",
              "enum": [
                "fail",
                "remove"
              ],
              "type": "string"
            },
            "PreprocessingFailureBehaviour": {
              "description": "What to do with a structure that fails preprocessing: `fail` aborts, `remove` drops it.",
              "enum": [
                "fail",
                "remove"
              ],
              "type": "string"
            },
            "StructureProcessingFailureBehaviour": {
              "description": "What to do with a structure OpenFold3 fails to process: `fail` aborts, `remove` drops it.",
              "enum": [
                "fail",
                "remove"
              ],
              "type": "string"
            },
            "ValidationFailureBehaviour": {
              "description": "What to do with a structure that fails validation: `fail` aborts, `ignore` keeps it.",
              "enum": [
                "fail",
                "ignore"
              ],
              "type": "string"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "description": "Config for the Apheris OpenFold3 fine-tuning cache generation wrapper.",
          "properties": {
            "ccd_path": {
              "description": "Path to the Chemical Component Dictionary (components.cif).",
              "format": "file-path",
              "pattern": "(?i)(\\.cif)$",
              "title": "CCD Path",
              "type": "string",
              "x-foundry-envvar": "APHERIS_CCD_PATH",
              "x-foundry-extensions": [
                ".cif"
              ],
              "x-foundry-mimetype": "chemical/x-cif",
              "x-foundry-path-resolution": "relative-or-absolute"
            },
            "missing_msas": {
              "$ref": "#/$defs/MissingMsaBehaviour",
              "default": "fail",
              "description": "What to do if a protein/RNA chain has no matching MSA in msa_dir: 'fail' aborts the run, 'ignore' backfills a dummy,\nquery-only MSA and continues. Gaps are logged to missing_msa_sequences.yaml either way. X in either sequence matches\nany residue.",
              "title": "Missing MSA Behaviour"
            },
            "msa_dir": {
              "description": "Directory of precomputed MSA files. Protein/RNA chains without their own MSA are matched to one here by sequence,\nnot by filename.",
              "format": "directory-path",
              "title": "MSA Directory",
              "type": "string",
              "x-foundry-path-resolution": "relative-or-absolute"
            },
            "msa_failures": {
              "$ref": "#/$defs/MsaFailureBehaviour",
              "default": "fail",
              "description": "What to do if an MSA file or directory in msa_dir can't be read: 'fail' aborts the run, 'remove' leaves it out and\ncontinues. Failures are logged to msa_failures.yaml.",
              "title": "MSA Failure Behaviour"
            },
            "preprocessing_failures": {
              "$ref": "#/$defs/PreprocessingFailureBehaviour",
              "default": "fail",
              "description": "What to do if a structure fails preprocessing: 'fail' aborts the run, 'remove' drops it and continues. Failures are\nlogged to preprocessing_failures.yaml.",
              "title": "Preprocessing Failure Behaviour"
            },
            "structure_processing_failures": {
              "$ref": "#/$defs/StructureProcessingFailureBehaviour",
              "default": "fail",
              "description": "What to do if OpenFold3 fails to process a structure: 'fail' aborts the run, 'remove' drops it and continues.\nFailures are logged to structure_processing_failures.yaml.",
              "title": "Structure Processing Failure Behaviour"
            },
            "validation_failures": {
              "$ref": "#/$defs/ValidationFailureBehaviour",
              "default": "fail",
              "description": "What to do if a structure fails geometric validation: 'fail' aborts the run, 'ignore' keeps it and continues.\nFailures are logged to validation_failures.yaml.",
              "title": "Validation Failure Behaviour"
            }
          },
          "title": "GenerateOpenFold3DatasetConfig",
          "type": "object",
          "x-foundry-flags": {
            "ccd_path": "--ccd-path",
            "missing_msas": "--missing-msas",
            "msa_dir": "--msa-dir",
            "msa_failures": "--msa-failures",
            "preprocessing_failures": "--preprocessing-failures",
            "structure_processing_failures": "--structure-processing-failures",
            "validation_failures": "--validation-failures"
          }
        },
        "schema_version": "foundry.cli.v1"
      },
      {
        "description": "",
        "exit_codes": [
          {
            "category": "success",
            "code": 0,
            "meaning": "success"
          },
          {
            "category": "internal",
            "code": 1,
            "meaning": "unexpected or uncaught error"
          },
          {
            "category": "usage",
            "code": 2,
            "meaning": "bad invocation or invalid config"
          },
          {
            "category": "input-data",
            "code": 3,
            "meaning": "inputs present but invalid"
          },
          {
            "category": "precondition",
            "code": 4,
            "meaning": "required resource absent"
          },
          {
            "category": "output",
            "code": 5,
            "meaning": "result produced but could not be persisted"
          },
          {
            "category": "cancelled",
            "code": 130,
            "meaning": "cancelled by SIGINT or SIGTERM"
          }
        ],
        "inputs": [
          {
            "flag": "--input",
            "repeatable": false,
            "required": true,
            "type": "directory"
          }
        ],
        "invocation": "apheris-openfold3 finetune --input ./in --output ./run --max-steps \u003cvalue\u003e",
        "name": "finetune",
        "output": {
          "flag": "--output",
          "required": true,
          "type": "directory"
        },
        "output_schema": {
          "$defs": {
            "EpochDetails": {
              "description": "Detailed inputs and per-structure metrics for one finetuning epoch.",
              "properties": {
                "aggregate_metrics": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": "Per-metric values aggregated across this epoch.",
                  "title": "Aggregate Metrics",
                  "type": "object"
                },
                "epoch": {
                  "description": "1-indexed training epoch this result is for (0 for sanity check).",
                  "title": "Epoch",
                  "type": "integer"
                },
                "epoch_steps": {
                  "description": "Number of optimizer steps completed during this epoch.",
                  "title": "Epoch Steps",
                  "type": "integer"
                },
                "total_steps": {
                  "description": "Total number of optimizer steps completed so far.",
                  "title": "Total Steps",
                  "type": "integer"
                },
                "training_samples": {
                  "description": "Per-structure metrics for training samples seen during this epoch.",
                  "items": {
                    "$ref": "#/$defs/StructureMetrics"
                  },
                  "title": "Training Samples",
                  "type": "array"
                },
                "validation_samples": {
                  "description": "Per-structure metrics for validation samples seen during this epoch.",
                  "items": {
                    "$ref": "#/$defs/StructureMetrics"
                  },
                  "title": "Validation Samples",
                  "type": "array"
                }
              },
              "required": [
                "epoch",
                "epoch_steps",
                "total_steps",
                "aggregate_metrics",
                "training_samples",
                "validation_samples"
              ],
              "title": "EpochDetails",
              "type": "object"
            },
            "EpochResult": {
              "description": "Metrics and checkpoint recorded for a complete epoch or the final partial epoch.",
              "properties": {
                "checkpoint_path": {
                  "description": "Retained top-K checkpoint, or `last.ckpt` for the final partial epoch.",
                  "format": "file-path",
                  "pattern": "(?i)(\\.ckpt)$",
                  "title": "Checkpoint Path",
                  "type": "string",
                  "x-foundry-extensions": [
                    ".ckpt"
                  ],
                  "x-foundry-path-resolution": "relative",
                  "x-foundry-path-traversal": false
                },
                "details_path": {
                  "description": "Path to this epoch's aggregate and per-structure metric details.",
                  "format": "file-path",
                  "pattern": "(?i)(\\.json)$",
                  "title": "Epoch Details Path",
                  "type": "string",
                  "x-foundry-extensions": [
                    ".json"
                  ],
                  "x-foundry-mimetype": "application/json",
                  "x-foundry-path-resolution": "relative",
                  "x-foundry-path-traversal": false,
                  "x-foundry-schema": {
                    "$ref": "#/$defs/EpochDetails"
                  }
                },
                "epoch": {
                  "description": "1-indexed training epoch this result is for (0 for sanity check).",
                  "title": "Epoch",
                  "type": "integer"
                },
                "epoch_steps": {
                  "description": "Number of optimizer steps completed during this epoch.",
                  "title": "Epoch Steps",
                  "type": "integer"
                },
                "metrics": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": "All trainer callback metrics captured at this epoch boundary, keyed by their original names.",
                  "title": "Metrics",
                  "type": "object"
                },
                "total_steps": {
                  "description": "Total number of optimizer steps completed so far.",
                  "title": "Total Steps",
                  "type": "integer"
                },
                "train_loss": {
                  "deprecated": true,
                  "description": "Mean training loss over this epoch. Deprecated; use metrics instead.",
                  "title": "Training Loss",
                  "type": "number"
                },
                "val_loss": {
                  "deprecated": true,
                  "description": "Mean validation loss over this epoch. Deprecated; use metrics instead.",
                  "title": "Validation Loss",
                  "type": "number"
                },
                "val_model_selection": {
                  "deprecated": true,
                  "description": "Value of `val/model_selection` for this epoch. Checkpoint ranking uses the metric configured by `checkpoint_metric`\ninstead. Deprecated; use metrics instead.",
                  "title": "Validation Model Selection Metric",
                  "type": "number"
                }
              },
              "required": [
                "epoch",
                "epoch_steps",
                "total_steps",
                "details_path"
              ],
              "title": "EpochResult",
              "type": "object"
            },
            "StructureMetrics": {
              "description": "Metrics calculated for one structure during an epoch.",
              "properties": {
                "metrics": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "description": "Per-metric values calculated for this structure.",
                  "title": "Metrics",
                  "type": "object"
                },
                "structure_id": {
                  "description": "Identifier of the structure this sample is for.",
                  "title": "Structure ID",
                  "type": "string"
                }
              },
              "required": [
                "structure_id",
                "metrics"
              ],
              "title": "StructureMetrics",
              "type": "object"
            }
          },
          "description": "Result of the finetune task.",
          "properties": {
            "epoch_metrics_path": {
              "description": "Compact CSV of per-epoch validation metrics.",
              "format": "file-path",
              "pattern": "(?i)(\\.csv)$",
              "title": "Epoch Metrics Path",
              "type": "string",
              "x-foundry-extensions": [
                ".csv"
              ],
              "x-foundry-mimetype": "text/csv",
              "x-foundry-path-resolution": "relative",
              "x-foundry-path-traversal": false
            },
            "epochs": {
              "description": "Metrics and checkpoint for every training epoch.",
              "items": {
                "$ref": "#/$defs/EpochResult"
              },
              "title": "Epochs",
              "type": "array"
            },
            "step_metrics_path": {
              "description": "Compact CSV of per-step training metrics.",
              "format": "file-path",
              "pattern": "(?i)(\\.csv)$",
              "title": "Step Metrics Path",
              "type": "string",
              "x-foundry-extensions": [
                ".csv"
              ],
              "x-foundry-mimetype": "text/csv",
              "x-foundry-path-resolution": "relative",
              "x-foundry-path-traversal": false
            }
          },
          "required": [
            "epochs",
            "step_metrics_path",
            "epoch_metrics_path"
          ],
          "title": "FinetuneOpenFold3Result",
          "type": "object"
        },
        "parameters": {
          "$defs": {
            "CheckpointMetric": {
              "description": "A validation metric to select checkpoints by.",
              "enum": [
                "lddt_intra_protein",
                "lddt_inter_protein_ligand",
                "lddt_inter_protein_protein"
              ],
              "type": "string"
            },
            "FinetuningPrecision": {
              "description": "The floating point precision to train in.",
              "enum": [
                "fp32",
                "bf16"
              ],
              "type": "string"
            }
          },
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "additionalProperties": false,
          "description": "Config for the Apheris OpenFold3 finetuning wrapper.",
          "properties": {
            "batches_per_step": {
              "default": 1,
              "description": "Number of training batches accumulated into each optimizer step.",
              "minimum": 1,
              "title": "Batches Per Step",
              "type": "integer"
            },
            "checkpoint_metric": {
              "$ref": "#/$defs/CheckpointMetric",
              "default": "lddt_inter_protein_ligand",
              "description": "Validation metric used to select the best checkpoint(s), when keep_top_n_checkpoints is set.",
              "title": "Checkpoint Selection Metric"
            },
            "crop_size": {
              "description": "Per-sample token crop size (OpenFold3 default: 384). The main lever for memory usage.",
              "exclusiveMinimum": 0,
              "title": "Token Crop Size",
              "type": "integer"
            },
            "ema_decay": {
              "description": "Exponential moving average decay (OpenFold3 default: 0.999).",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "title": "EMA Decay",
              "type": "number"
            },
            "keep_top_n_checkpoints": {
              "default": 1,
              "description": "Number of best checkpoints to keep by checkpoint_metric, plus the most recent. -1 keeps all.",
              "minimum": -1,
              "title": "Checkpoints To Keep",
              "type": "integer"
            },
            "learning_rate": {
              "description": "Learning rate (OpenFold3 default: 1.8e-3).",
              "exclusiveMinimum": 0,
              "title": "Learning Rate",
              "type": "number"
            },
            "learning_rate_warmup_steps": {
              "description": "Number of optimizer steps used for learning rate warmup (OpenFold3 default: 1000).",
              "minimum": 0,
              "title": "Learning Rate Warmup Steps",
              "type": "integer"
            },
            "max_steps": {
              "description": "Number of optimizer steps to run.",
              "exclusiveMinimum": 0,
              "title": "Max Optimizer Steps",
              "type": "integer"
            },
            "precision": {
