        "input_schema": {
          "$defs": {
            "InputQueryBranchedPolymerComponentChain": {
              "additionalProperties": false,
              "description": "Input defining a single branched polymer chain.",
              "properties": {
                "bonds": {
                  "description": "Bonds connecting the chain's components into a single structure - every component must end up connected, directly or\ntransitively, to the others.",
                  "items": {
                    "$ref": "#/$defs/InputQueryIntraChainBond"
                  },
                  "title": "Connecting Bonds",
                  "type": "array"
                },
                "chain_id": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional chain ID, unique across all chains in the query. Auto-assigned if omitted.",
                  "title": "Chain ID"
                },
                "component_ids": {
                  "description": "CCD (or custom) component IDs, one per residue, in order. At least 2 required.",
                  "items": {
                    "minLength": 1,
                    "pattern": "\\S",
                    "type": "string"
                  },
                  "minItems": 2,
                  "title": "Component IDs",
                  "type": "array"
                },
                "residue_ids": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Optional per-residue labels, one per entry in `component_ids`. Auto-numbered if omitted.",
                  "title": "Residue IDs"
                }
              },
              "required": [
                "component_ids",
                "bonds"
              ],
              "title": "InputQueryBranchedPolymerComponentChain",
              "type": "object"
            },
            "InputQueryChains": {
              "additionalProperties": false,
              "description": "Input defining a query inline as chains plus optional inter-chain bonds.",
